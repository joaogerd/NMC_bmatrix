# Pacote NMC 22--25 junho de 2026.
# Editar antes de executar scripts/run_campaign.sh bootstrap.

# Diretórios de repositórios. Não precisam ser os mesmos em que este ZIP foi extraído.
WORKFLOW_REPO=/p/projetos/monan_das/joao.gerd/projects/monan-jedi-workflow
BMATRIX_REPO=/p/projetos/monan_das/joao.gerd/projects/mpas-bmatrix-global
BMATRIX_CONFIG=/p/projetos/monan_das/joao.gerd/projects/mpas-bmatrix-global/configs/jaci-x1.10242.yaml

# Ambiente JACI que já carrega módulos Cray/MPICH e demais variáveis.
JACI_ENV_SCRIPT=/p/projetos/monan_das/joao.gerd/projects/mpas-bmatrix-global/scripts/load_jaci_env.sh
MPIEXEC=/opt/cray/pals/1.6/bin/mpiexec

# Build MPAS-JEDI e malha x1.10242.
INSTALL_ROOT=/p/projetos/monan_das/joao.gerd/builds/monan-jedi-mpas
MESH_ROOT=/p/projetos/monan_das/joao.gerd/projects/mpas_meshes/quasi_uniform/x1.10242_240km
MESH=x1.10242
NPROC=128

# Perfil físico e arquivos de referência para a malha x1.10242 (~240 km).
# O perfil 240 km é obrigatório: o pacote não aceita fallback para um
# namelist genérico do core_atmosphere.
TUTORIAL_PHYSICS_DIR=/p/projetos/monan_das/joao.gerd/external-inputs/mpasjedi_tutorial202509NCAR/MPAS_namelist_stream_physics_files
FORECAST_NAMELIST_SOURCE=${TUTORIAL_PHYSICS_DIR}/namelist.atmosphere_240km
FORECAST_STREAMS_SOURCE=${TUTORIAL_PHYSICS_DIR}/streams.atmosphere_240km
INIT_NAMELIST_SOURCE=${INSTALL_ROOT}/share/MPAS/core_init_atmosphere/namelist.init_atmosphere
INIT_STREAMS_SOURCE=${INSTALL_ROOT}/share/MPAS/core_init_atmosphere/streams.init_atmosphere
INVARIANT_FILE=/p/projetos/monan_das/joao.gerd/external-inputs/mpasjedi_tutorial202509NCAR/MPAS_namelist_stream_physics_files/x1.10242.invariant.nc

# WPS utilizado pela campanha quando INPUT_MODE=raw_grib.
WPS_ROOT=/p/projetos/monan_das/joao.gerd/data/mpas-bmatrix-global/external/WPS/WPS-4.6.0

# Raiz de trabalho da campanha. Deve ser definida ANTES de qualquer
# variável derivada, pois este arquivo é carregado com "set -u".
WORK_ROOT=/p/projetos/monan_das/joao.gerd/work/nmc-bmatrix-20260622-20260625

# Entrada atmosférica da campanha.
#
# download_gfs (PADRÃO): não exige FILE:* nem GRIB pré-existente. O workflow
# baixa cinco GFS f000 (20--24/06/2026, 00Z) para RAW_GFS_ROOT, roda UNGRIB e
# então produz as cinco condições iniciais MPAS. Esta é a opção correta para
# este caso.
# raw_grib: os cinco GFS f000 já existem em RAW_GFS_ROOT; só roda UNGRIB.
# prebuilt_wps: os cinco FILE:YYYY-MM-DD_HH já existem em WPS_FILE_ROOT;
#               UNGRIB é pulado.
INPUT_MODE=download_gfs

# Diretório persistente em que os cinco GRIBs serão gravados quando
# INPUT_MODE=download_gfs. Não precisa existir antes do primeiro download.
RAW_GFS_ROOT=$WORK_ROOT/inputs/gfs
WPS_FILE_ROOT=/CAMINHO/USADO_SOMENTE_SE_INPUT_MODE_PREBUILT_WPS

# Fonte primária dos GFS pgrb2 0.25º f000. Os placeholders são renderizados
# pelo monan-jedi-workflow para cada ciclo. Não substitua por um caminho local.
# O objeto remoto precisa estar disponível no momento da execução; para datas
# históricas fora da retenção da fonte, substitua por uma URL de arquivo acessível
# ou utilize INPUT_MODE=raw_grib após obter os arquivos por outra via.
GFS_URL_TEMPLATE=https://noaa-gfs-bdp-pds.s3.amazonaws.com/gfs.{cycle_year}{cycle_month}{cycle_day}/{cycle_hour}/atmos/gfs.t{cycle_hour}z.pgrb2.0p25.f000
GFS_MIN_BYTES=10000000

# Raízes produzidas pela campanha.
WPS_OUTPUT_ROOT=$WORK_ROOT/wps
MPAS_INIT_ROOT=$WORK_ROOT/mpas_init
MPAS_RUN_ROOT=$WORK_ROOT/mpas_runs
CAMPAIGN_ROOT=$WORK_ROOT/campaign
BFLOW_WORKSPACE=$WORK_ROOT/bflow

# PBS e configuração MPAS.
INIT_QUEUE=pesqmini
FORECAST_QUEUE=pesqmidi
INIT_WALLTIME=00:10:00
F024_WALLTIME=01:00:00
F048_WALLTIME=02:00:00

# Para x1.10242, use o perfil 240 km com dt coerente.
# 1200 s é o padrão da campanha; 1440 s é a alternativa permitida após
# validar um f24 completo com o mesmo namelist, física e partição.
# Não misture dt entre pares f024/f048 nem entre tempos válidos.
CONFIG_DT=1200
OUTPUT_INTERVAL=24:00:00
