# Local JACI configuration for the NMC 22--25 Jun 2026 campaign.
# Copy to config/site.env, then adjust only paths that differ on your account.
#
# IMPORTANT: this file has ONE runtime root. All GRIB, WPS, init, forecasts,
# campaign state, manifest and BFLOW workspace are derived internally from it.
# Do not define secondary WPS/MPAS roots.

WORKFLOW_REPO=/p/projetos/monan_das/${USER}/projects/monan-jedi-workflow
BMATRIX_REPO=/p/projetos/monan_das/${USER}/projects/mpas-bmatrix-global
BMATRIX_CONFIG=/p/projetos/monan_das/${USER}/projects/mpas-bmatrix-global/configs/jaci-x1.10242.yaml

JACI_ENV_SCRIPT=/p/projetos/monan_das/${USER}/projects/mpas-bmatrix-global/scripts/load_jaci_env.sh
MPIEXEC=/opt/cray/pals/1.6/bin/mpiexec

INSTALL_ROOT=/p/projetos/monan_das/${USER}/builds/monan-jedi-mpas
MESH_ROOT=/p/projetos/monan_das/${USER}/projects/mpas_meshes/quasi_uniform/x1.10242_240km
MESH=x1.10242
NPROC=128
# Static interpolation is one-time per mesh. CD-CT uses 128 ranks on JACI.
STATIC_NPROC=128

TUTORIAL_PHYSICS_DIR=/p/projetos/monan_das/${USER}/external-inputs/mpasjedi_tutorial202509NCAR/MPAS_namelist_stream_physics_files
FORECAST_NAMELIST_SOURCE=${TUTORIAL_PHYSICS_DIR}/namelist.atmosphere_240km
FORECAST_STREAMS_SOURCE=${TUTORIAL_PHYSICS_DIR}/streams.atmosphere_240km
INIT_NAMELIST_SOURCE=${INSTALL_ROOT}/share/MPAS/core_init_atmosphere/namelist.init_atmosphere
INIT_STREAMS_SOURCE=${INSTALL_ROOT}/share/MPAS/core_init_atmosphere/streams.init_atmosphere
INVARIANT_FILE=${TUTORIAL_PHYSICS_DIR}/x1.10242.invariant.nc
WPS_ROOT=/p/projetos/monan_das/${USER}/data/mpas-bmatrix-global/external/WPS/WPS-4.6.0

# MPAS static interpolation consumes the WPS geographic tiles, not the WPS
# executables above. This is the CD-CT JACI location; preflight requires
# topo_gmted2010_30s/index below it.
WPS_GEOG_ROOT=/p/projetos/monan_adm/monan/dados/MONAN_v1.4.x/MONAN_datain/datain/WPS_GEOG
STATIC_REFERENCE_TIME=2010-10-23_00:00:00

# One and only one campaign runtime root.
CAMPAIGN_ROOT=/p/projetos/monan_das/${USER}/work/nmc_bmatrix_20260622_20260625

# Input mode:
#   download_gfs  downloads five GFS f000 products (default)
#   raw_grib      expects those five GFS f000 products already at CAMPAIGN_ROOT/inputs/gfs
#   prebuilt_wps  expects FILE:YYYY-MM-DD_HH at WPS_FILE_ROOT and does not execute WPS
INPUT_MODE=download_gfs
WPS_FILE_ROOT=/CAMINHO/USADO_SOMENTE_COM_INPUT_MODE_PREBUILT_WPS
GFS_URL_TEMPLATE=https://noaa-gfs-bdp-pds.s3.amazonaws.com/gfs.{cycle_year}{cycle_month}{cycle_day}/{cycle_hour}/atmos/gfs.t{cycle_hour}z.pgrb2.0p25.f000
GFS_MIN_BYTES=10000000

STATIC_QUEUE=pesqmini
INIT_QUEUE=pesqmini
FORECAST_QUEUE=pesqmidi
STATIC_WALLTIME=00:20:00
INIT_WALLTIME=00:10:00
# The stage configuration cannot choose a walltime per lead dynamically.
# Use the f048 walltime for both f024/f048 unless the workflow gains per-lead PBS settings.
FORECAST_WALLTIME=02:00:00

# Coherent with the supplied x1.10242 240-km profile.
CONFIG_DT=1200
OUTPUT_INTERVAL=24:00:00
